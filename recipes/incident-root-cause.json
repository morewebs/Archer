      "icon": "server",
      "color": "#fb7185",
      "status": "err",
      "statusText": "thread lock",
      "metrics": "Goroutines: 120,000",
      "submetrics": "All 64 Pods Hung",
      "boundary": "b-app",
      "stage": 2,
      "lane": 0,
      "alert": "💥 DEADLOCK: HikariCP / pgx pool blocked on getResource()",
