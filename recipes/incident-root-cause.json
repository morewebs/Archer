        { "k": "Thread Dump", "v": "Waiting on DB socket read" },
        { "k": "Healthcheck", "v": "Liveness Probe Failed" }
      ],
      "hasInput": true,
      "hasOutput": true
    },
    {
      "id": "primary-db",
      "title": "PostgreSQL 15 Primary",
      "subtitle": "pg-master.internal:5432",
      "category": "ROOT CAUSE",
      "icon": "database",
      "color": "#e11d48",
      "status": "err",
      "statusText": "exhausted",
      "metrics": "max_connections: 500",
      "submetrics": "Active: 500 (100% Max)",
      "boundary": "b-db",
      "stage": 3,
      "lane": 0,
      "alert": "💥 ROOT CAUSE: Unindexed query lock cascade held exclusive table lock",
      "details": [
        { "k": "Offending Query", "v": "UPDATE inventory SET count = ..." },
        { "k": "Lock Type", "v": "RowExclusiveLock held 1240s" },
        { "k": "Disk I/O Latency", "v": "Spiked to 3,400ms" }
