      "hasInput": true,
      "hasOutput": false
    }
  ],
  "edges": [
    {
      "from": "public-traffic",
      "to": "ingress-gw",
      "label": "Spike 35,000 RPS",
      "color": "#fbbf24",
      "status": "warn"
    },
    {
      "from": "ingress-gw",
      "to": "app-workers",
      "label": "Proxy Forward (Hangs 60s)",
      "color": "#fb7185",
      "status": "err"
    },
    {
      "from": "app-workers",
      "to": "primary-db",
      "label": "💥 FATAL: Pool Exhaustion (500/500)",
      "color": "#e11d48",
      "status": "err"
    }
  ]
