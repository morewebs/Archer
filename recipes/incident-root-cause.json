      "hasInput": false,
      "hasOutput": true
    },
    {
      "id": "ingress-gw",
      "title": "Cloudflare & NGINX Edge",
      "subtitle": "edge-lb-01.prod:443",
      "category": "EDGE INGRESS",
      "icon": "gateway",
      "color": "#fbbf24",
      "status": "warn",
      "statusText": "timeout",
      "metrics": "504 Gateway Timeout",
      "submetrics": "Queue full (60s cap)",
      "boundary": "b-ingress",
      "stage": 1,
      "lane": 0,
      "alert": "⚠️ Cascaded timeout: Upstream backend workers unresponsive",
