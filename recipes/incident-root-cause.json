        { "k": "Worker Keep-Alive", "v": "Maxed (65,535 conns)" },
        { "k": "Buffer Pool", "v": "100% Saturation" }
      ],
      "hasInput": true,
      "hasOutput": true
    },
    {
      "id": "app-workers",
      "title": "Checkout API Pods",
      "subtitle": "k8s-pod-checkout-* (64 Pods)",
